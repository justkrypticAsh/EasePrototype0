# EasePrototype0 Environment Configuration

# Application
APP_ENV=development
APP_NAME=EasePrototype0
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Biometric & Sensitive Vault Encryption (AES-256 Fernet key, 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTEyMzQ1Njc4OTAxMjM0NQ==

# Database (SQLite default for prototype, Postgres ready: postgresql+asyncpg://user:pass@localhost:5432/ease)
DATABASE_URL=sqlite+aiosqlite:///./ease_prototype.db

# Provider Selection
STT_PROVIDER=assemblyai        # Options: assemblyai, deepgram
LLM_PROVIDER=gemini            # Options: gemini, claude
EMBEDDING_PROVIDER=gemini      # Options: gemini

# Provider API Keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Audio Storage & Retention
AUDIO_STORAGE_PATH=./audio_uploads
AUDIO_RETENTION_DAYS=30

# Rate Limits (per user/project)
MAX_MEETINGS_PER_DAY=20
MAX_AUDIO_MINUTES_PER_MEETING=120
